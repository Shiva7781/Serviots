NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/Serviots

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173

# Booking rules
SLOT_MINUTES=30
OPEN_TIME=08:00
CLOSE_TIME=20:00

# Email notifications on booking status change (optional).
# Leave unset to run in stub mode - the email body is logged to the console
# instead of being sent. Set all three to send real email via SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
